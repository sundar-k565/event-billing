{
  "name": "waaat-pos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests *.ts *.mjs *.json README.md",
    "format:check": "prettier --check src scripts tests *.ts *.mjs *.json README.md",
    "test": "vitest run",
    "test:db": "tsx scripts/test-db.ts",
    "test:auth": "tsx scripts/test-auth.ts",
    "local:setup": "node scripts/local-setup.mjs",
    "test:e2e": "playwright test",
    "seed:validate": "tsx scripts/seed.ts --validate",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "check": "npm run seed:validate && npm test && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
