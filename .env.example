# Docker Compose configuration. Generate real secrets with:
# node scripts/local-setup.mjs
# All credentials below are LOCAL/SERVER ONLY; no NEXT_PUBLIC values are required.
POSTGRES_PASSWORD=replace-with-random-hex-secret
APP_DATABASE_PASSWORD=replace-with-random-hex-secret
BOOTSTRAP_ADMIN_EMAIL=admin@waaat.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-long-random-password
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
# Local HTTP only. Set true when serving through HTTPS.
COOKIE_SECURE=false

# Optional host development (.env.local), after starting compose.dev.yaml:
# DATABASE_URL=postgresql://waaat_app:YOUR_APP_DATABASE_PASSWORD@127.0.0.1:5433/waaat
# Migration CLI uses the postgres owner connection, never the runtime user.
